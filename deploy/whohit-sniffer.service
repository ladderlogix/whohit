[Unit]
Description=whoHit: log inbound connection attempts (port, source, protocol)
After=network-online.target
Wants=network-online.target

[Service]
User=whohit
Group=whohit
ExecStart=/usr/bin/python3 /opt/whohit/sniffer.py
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
StateDirectory=whohit
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryMax=512M
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
